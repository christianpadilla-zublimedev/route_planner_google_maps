<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_create_route_wizard_form"
            model="ir.ui.view">

        <field name="name">route.planner.create.wizard.form</field>

        <field name="model">route.planner.create.wizard</field>

        <field name="arch" type="xml">

            <form string="Create Route">

                <group>

                    <field name="order_count" readonly="1"/>

                </group>

                <footer>

                    <button
                        name="action_create_route"
                        type="object"
                        string="Create Route"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>